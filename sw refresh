self.addEventListener('install',e=>self.skipWaiting());
self.addEventListener('activate',e=>{self.clients.claim();e.waitUntil(caches.keys().then(ks=>Promise.all(ks.map(k=>caches.delete(k)))));});
self.addEventListener('fetch',e=>{e.respondWith(fetch(e.request).then(r=>{const cp=r.clone();caches.open('cm2').then(c=>c.put(e.request,cp));return r;}).catch(()=>caches.match(e.request)));});